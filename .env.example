# Copy to .env (or set in your host's environment). All values are optional in development.
PORT=4000
# Required in production: a long random string used to sign access tokens.
JWT_SECRET=
# Access tokens live 15 minutes; refresh tokens 7 days (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# SQLite file location.
DB_FILE=./data/orbit.db
# true = load demo schools on first start, show the location simulator, and serve the mock SIS/LMS.
# Defaults to true unless NODE_ENV=production.
DEMO_MODE=
# Public URL of this server (used to reach the bundled mock SIS/LMS when behind a proxy).
PUBLIC_URL=
LOG_LEVEL=info
