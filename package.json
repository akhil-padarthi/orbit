{
  "name": "orbit",
  "version": "1.0.0",
  "description": "Orbit \u2014 real-time attendance, scheduling and communication platform for multi-tenant school districts.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build-client.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/db/seed.js --reset",
    "create-tenant": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-tenant.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.js\"",
    "test:api": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.js"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akhil-padarthi/orbit.git"
  },
  "license": "MIT"
}
